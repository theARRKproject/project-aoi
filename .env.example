# Optional configuration; the CLI uses environment variables (not .env parsing).
# Set these in your shell, or load this file with an external shell utility.
AOI_MODEL_NAME=Qwen/Qwen2.5-3B-Instruct
AOI_DB_PATH=data/aoi.sqlite3
AOI_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
AOI_MAX_NEW_TOKENS=180
AOI_TEMPERATURE=0.7
AOI_MEMORY_THRESHOLD=0.30
